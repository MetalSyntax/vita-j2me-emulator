######################################################################
#
# Makefile for building and packaging (Vita target).
# Fase 2: clon de midp/build/javacall_psp/psp_mips.gmk adaptado a Vita.
#
# Cambios PSP -> Vita:
#   TARGET_CPU    mips -> arm   (Cortex-A9 de la Vita; CVM usa
#                               C-interpreter arch=c igual que en PSP,
#                               ver cldc/build/javacall_vita_gcc/*.cfg)
#   TARGET_DEVICE psp  -> vita
#   -G0 (MIPS-only)    -> eliminado
#   -DPSP              -> -DVITA -DARM
#   PATHSEP            -> : (separador CLASSPATH unix; PSP usaba \;)
#   (Fase 2b: primero se puso / por error; los classpaths se concatenaban)
#
######################################################################

GNU_TOOLS_DIR = $(VITASDK)

# Definition of platform to build on
HOST_PLATFORM		= javacall
HOST_OS			= javacall
HOST_CPU		= i386
HOST_COMPILER		= gcc

# Definition of platform to run on
TARGET_PLATFORM		= javacall
TARGET_OS		= javacall
TARGET_CPU		= arm
TARGET_DEVICE		= vita
TARGET_COMPILER		= gcc
TARGET_VM		= cldc_vm

# Platform-specific compiler flags
# -marm: vitasdk compila en Thumb-2 por defecto, pero el ASM inline de
# 2009 (gxj_graphics_asm.c, instrucciones condicionales A32) exige ARM.
EXTRA_CPPFLAGS += -DVITA -DARM -fno-strict-aliasing -mfloat-abi=softfp -marm
EXTRA_CFLAGS += -DVITA -DARM -fno-strict-aliasing -mfloat-abi=softfp -marm
PATHSEP = :

# Platform-specific linker flags and libraries
LIBS += $(JAVACALL_LIB_DIR)/javacall$(g).lib

# Add support for dynamic properties file
#MIDP_DEPS += copy_configuration_file
